rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function active() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    function admin() { return active() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function presenter() { return active() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['presenter','admin']; }
    function str(s, min, max) { return s is string && s.size() >= min && s.size() <= max; }
    function validUser(d) {
      return d.keys().hasAll(['firstName','lastName','title','affiliation','email','requestedRole','role','status','attended','createdAt','updatedAt'])
        && d.keys().hasOnly(['firstName','lastName','title','affiliation','email','requestedRole','role','status','attended','createdAt','updatedAt'])
        && str(d.firstName,1,60) && str(d.lastName,1,60) && str(d.title,0,60) && str(d.affiliation,1,160)
        && str(d.email,3,254) && d.requestedRole in ['guest','presenter'] && d.role in ['guest','presenter','admin']
        && d.status in ['pending','approved','rejected'] && d.attended is bool
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow create: if owner(uid) && validUser(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'guest' && request.resource.data.status == 'pending'
        && request.resource.data.attended == false && request.resource.data.createdAt == request.time;
      allow update: if validUser(request.resource.data) && (
        (owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName','lastName','title','affiliation','updatedAt']))
        || (admin() && uid != request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status','attended','updatedAt']))
      );
      allow delete: if false;
    }
    function validSession(d) {
      return d.keys().hasOnly(['day','time','end','titleEn','titleHr','room','type'])
        && d.day in ['16','17','18','19','20'] && ((d.time == '' && d.end == '') || (d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && d.end > d.time))
        && str(d.titleEn,1,250) && str(d.titleHr,1,250) && str(d.room,0,120) && str(d.type,1,80);
    }
    match /sessions/{id} {
      allow read: if true;
      allow create, update: if admin() && validSession(request.resource.data);
      allow delete: if admin();
    }
    function validPresenter(d) {
      return d.keys().hasOnly(['name','titleEn','titleHr','bioEn','bioHr','photo'])
        && str(d.name,1,160) && str(d.titleEn,1,120) && str(d.titleHr,1,120)
        && str(d.bioEn,1,2000) && str(d.bioHr,1,2000) && str(d.photo,0,1500)
        && (d.photo == '' || d.photo.matches('^https://.*'));
    }
    match /presenters/{id} {
      allow read: if true;
      allow create, update: if admin() && validPresenter(request.resource.data);
      allow delete: if admin();
    }
    function validPromo(d, uid, target) {
      let claim = /databases/$(database)/documents/discountClaims/$(uid);
      let code = d.get('promoCode','');
      return (code == '' && (!existsAfter(claim) || getAfter(claim).data.target != target))
        || (code is string && existsAfter(claim) && getAfter(claim).data.code == code && getAfter(claim).data.target == target);
    }
    match /promoCodes/{code} {
      allow get: if admin() || (active() && (!exists(/databases/$(database)/documents/promoCodes/$(code)) || resource.data.usedBy == '' || resource.data.usedBy == request.auth.uid));
      allow list: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['percent','year','createdBy','createdAt','usedBy','usedAt'])
        && ((request.resource.data.percent == 20 && code.matches('^P20[A-Z]{3}$')) || (request.resource.data.percent == 50 && code.matches('^P50[A-Z]{3}$')) || (request.resource.data.percent == 100 && code.matches('^P100[A-Z]{3}$')))
        && request.resource.data.year == 2027 && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.usedBy == '' && request.resource.data.usedAt == null;
      allow update: if active() && resource.data.usedBy == '' && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy','usedAt'])
        && !exists(/databases/$(database)/documents/discountClaims/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/discountClaims/$(request.auth.uid)).data.code == code;
      allow delete: if false;
    }
    match /discountClaims/{uid} {
      allow get: if admin() || (active() && owner(uid));
      allow list: if admin();
      allow create: if active() && owner(uid)
        && request.resource.data.keys().hasOnly(['code','percent','year','target','ownerId','name','email','claimedAt'])
        && request.resource.data.ownerId == uid && request.resource.data.year == 2027 && request.resource.data.claimedAt == request.time
        && request.resource.data.target in ['submissions','guestRegistrations']
        && request.resource.data.name == get(/databases/$(database)/documents/users/$(uid)).data.firstName + ' ' + get(/databases/$(database)/documents/users/$(uid)).data.lastName
        && request.resource.data.email == get(/databases/$(database)/documents/users/$(uid)).data.email
        && get(/databases/$(database)/documents/promoCodes/$(request.resource.data.code)).data.usedBy == ''
        && request.resource.data.percent == get(/databases/$(database)/documents/promoCodes/$(request.resource.data.code)).data.percent
        && getAfter(/databases/$(database)/documents/promoCodes/$(request.resource.data.code)).data.usedBy == uid
        && getAfter(/databases/$(database)/documents/promoCodes/$(request.resource.data.code)).data.usedAt == request.time
        && getAfter(/databases/$(database)/documents/$(request.resource.data.target)/$(uid)).data.promoCode == request.resource.data.code
        && getAfter(/databases/$(database)/documents/$(request.resource.data.target)/$(uid)).data.updatedAt == request.time;
      allow update, delete: if false;
    }
    function validRegistration(r) {
      return r.keys().hasAll(['institution','address','city','country','vat','contactEmail','phone','registrationType','payingAs','keywords','termsAccepted'])
        && r.keys().hasOnly(['institution','address','city','country','vat','contactEmail','phone','registrationType','payingAs','keywords','termsAccepted'])
        && str(r.institution,1,250) && str(r.address,1,250) && str(r.city,1,120) && str(r.country,1,250)
        && str(r.vat,0,80) && (r.payingAs != 'company' || r.vat.size() > 0)
        && str(r.contactEmail,3,254) && r.contactEmail.matches('^[^ @]+@[^ @]+[.][^ @]+$')
        && str(r.phone,1,80) && r.registrationType in ['one','two','three','par']
        && r.payingAs in ['company','person'] && str(r.keywords,1,500) && r.keywords.split(',').size() <= 5
        && r.termsAccepted == true;
    }
    function validSubmission(d,uid) {
      return d.keys().hasOnly(['title','authors','abstract','paperUrl','ownerId','status','updatedAt','registration','feeStatus','promoCode'])
        && validPromo(d,uid,'submissions') && d.ownerId == uid && str(d.title,1,250) && str(d.authors,1,500) && str(d.abstract,1,12000)
        && str(d.paperUrl,0,2000) && (d.paperUrl == '' || d.paperUrl.matches('^https://[^ ].*'))
        && (!('registration' in d) || (validRegistration(d.registration) && d.abstract.split('\\s+').size() <= 400))
        && (!('feeStatus' in d) || d.feeStatus in ['pending','approved','rejected'])
        && d.status in ['submitted','accepted','revision','rejected'] && d.updatedAt == request.time;
    }
    match /submissions/{uid} {
      allow get: if (active() && owner(uid)) || admin();
      allow list: if admin();
      allow create: if owner(uid) && presenter() && validSubmission(request.resource.data,uid)
        && request.resource.data.status == 'submitted' && request.resource.data.get('feeStatus','pending') == 'pending';
      allow update: if validSubmission(request.resource.data,uid) && (
        (owner(uid) && presenter() && request.resource.data.status == 'submitted'
          && request.resource.data.get('feeStatus','pending') == 'pending')
        || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','feeStatus','updatedAt']))
      );
      allow delete: if false;
    }
    match /guestRegistrations/{uid} {
      allow read: if admin() || (active() && owner(uid));
      allow create, update: if request.resource.data.keys().hasOnly(['name','institution','email','plan','code','terms','ownerId','status','updatedAt','promoCode'])
        && validPromo(request.resource.data,uid,'guestRegistrations')
        && (!('promoCode' in request.resource.data) || request.resource.data.plan != 'par' || getAfter(/databases/$(database)/documents/discountClaims/$(uid)).data.percent == 100)
        && str(request.resource.data.name,1,160) && str(request.resource.data.institution,1,250)
        && str(request.resource.data.email,3,254) && request.resource.data.plan in ['standard','par']
        && str(request.resource.data.code,0,100) && (request.resource.data.plan != 'par' || request.resource.data.code.size()>0)
        && request.resource.data.terms == true && request.resource.data.ownerId == uid && request.resource.data.updatedAt == request.time
        && ((active() && owner(uid) && request.resource.data.status == 'submitted')
          || (admin() && request.resource.data.status in ['submitted','accepted','rejected'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])));
      allow delete: if false;
    }
    match /settings/certificates {
      allow read: if active();
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['x','y','fontSize','published','hasTemplate','templatePath'])
        && request.resource.data.x is number && request.resource.data.x >= 10 && request.resource.data.x <= 90
        && request.resource.data.y is number && request.resource.data.y >= 10 && request.resource.data.y <= 90
        && request.resource.data.fontSize is number && request.resource.data.fontSize >= 10 && request.resource.data.fontSize <= 60
        && str(request.resource.data.templatePath,1,200)
        && request.resource.data.templatePath.matches('^assets/documents/[A-Za-z0-9_-]+[.]pdf$')
        && request.resource.data.published is bool && request.resource.data.hasTemplate == true;
      allow delete: if false;
    }
    function canReadNotice(d) {
      return active() && (d.audience == 'all' || d.audience == 'role:' + get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role || d.audience == 'user:' + request.auth.uid);
    }
    match /notifications/{id} {
      allow read: if admin() || canReadNotice(resource.data);
      allow create: if admin() && request.resource.data.keys().hasOnly(['titleEn','titleHr','bodyEn','bodyHr','audience','createdBy','createdAt'])
        && str(request.resource.data.titleEn,1,180) && str(request.resource.data.titleHr,1,180)
        && str(request.resource.data.bodyEn,1,20000) && str(request.resource.data.bodyHr,1,20000)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && (request.resource.data.audience in ['all','role:guest','role:presenter','role:admin'] || request.resource.data.audience.matches('^user:[A-Za-z0-9_-]{1,128}$'));
      allow update: if false;
      allow delete: if admin();
    }
    match /users/{uid}/savedSessions/{sessionId} {
      allow read, delete: if active() && owner(uid);
      allow create, update: if active() && owner(uid) && sessionId.size() <= 128
        && request.resource.data.keys().hasOnly(['savedAt']) && request.resource.data.savedAt == request.time;
    }
    match /users/{uid}/notificationReads/{noticeId} {
      allow read, delete: if active() && owner(uid);
      allow create, update: if active() && owner(uid)
        && canReadNotice(get(/databases/$(database)/documents/notifications/$(noticeId)).data)
        && request.resource.data.keys().hasOnly(['readAt']) && request.resource.data.readAt == request.time;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
